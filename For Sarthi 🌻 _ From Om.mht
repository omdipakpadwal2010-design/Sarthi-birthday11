@charset "utf-8";

:root { --bg: #090b08; --gold: #d8b56d; --cream: #f4eddf; --muted: #aaa597; --panel: #13150f; --line: rgba(216,181,109,.22); }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 25px; }

body { background: var(--bg); color: var(--cream); font-family: "DM Sans", sans-serif; overflow-x: hidden; }

body.locked { overflow: hidden; }

button, input { font: inherit; }

button { -webkit-tap-highlight-color: transparent; cursor: pointer; }

::selection { background: var(--gold); color: rgb(9, 11, 8); }

a { color: inherit; text-decoration: none; }

.grain { position: fixed; inset: 0px; pointer-events: none; z-index: 20; opacity: 0.1; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.88' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.3'/%3E%3C/svg%3E"); }

.intro { position: fixed; inset: 0px; z-index: 100; background: rgb(9, 11, 8); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; transition: opacity 1s, visibility 1s; }

.intro.gone { opacity: 0; visibility: hidden; pointer-events: none; }

.intro-flower { font-size: 64px; filter: drop-shadow(rgba(216, 181, 109, 0.267) 0px 0px 22px); animation: 3s ease-in-out 0s infinite normal none running breathe; }

.eyebrow { font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: var(--gold); }

.intro h1 { font: 400 clamp(45px, 12vw, 75px) / 1.08 "Cormorant Garamond", serif; margin: 25px 0px 16px; }

.intro h1 em, .hero h1 em, .section-title em { color: var(--gold); }

.intro p { max-width: 290px; color: var(--muted); font-size: 13px; line-height: 1.9; }

.open-btn { margin-top: 36px; border: 1px solid var(--gold); background: transparent; color: var(--gold); padding: 16px 28px; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; transition: 0.3s; }

.open-btn:hover { background: var(--gold); color: rgb(9, 11, 8); }

.intro-small { position: absolute; bottom: 28px; color: rgb(102, 102, 93); font-size: 9px; letter-spacing: 3px; }

@keyframes breathe { 
  50% { transform: scale(1.12) rotate(5deg); }
}

.topbar { display: flex; justify-content: space-between; align-items: center; padding: 24px 7%; border-bottom: 1px solid rgba(255, 255, 255, 0.043); }

.brand { font: 500 24px "Cormorant Garamond", serif; letter-spacing: 2px; }

.brand span { color: var(--gold); }

.top-right { font-size: 9px; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; }

main { width: 100%; }

.hero { min-height: 85svh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 75px 22px 90px; text-align: center; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; width: 320px; height: 320px; border-radius: 50%; background: rgba(216, 181, 109, 0.04); filter: blur(60px); pointer-events: none; }

.hero-flower { font-size: 48px; margin-bottom: 30px; filter: drop-shadow(rgba(216, 181, 109, 0.2) 0px 0px 22px); }

.hero h1 { font: 400 clamp(62px, 16vw, 112px) / 0.95 "Cormorant Garamond", serif; margin: 24px 0px; position: relative; }

.hero h1 em { font-weight: 400; }

.hero-desc { max-width: 300px; color: var(--muted); line-height: 2; font-size: 13px; }

.hero-date { margin-top: 38px; font-size: 9px; color: var(--gold); letter-spacing: 4px; text-transform: uppercase; }

.scroll-hint { position: absolute; bottom: 26px; font-size: 9px; letter-spacing: 3px; color: rgb(129, 123, 110); }

.scroll-hint span { display: block; margin-top: 12px; font-size: 17px; animation: 1.5s ease 0s infinite normal none running down; }

@keyframes down { 
  50% { transform: translateY(6px); }
}

.section { padding: 85px 23px; max-width: 760px; margin: auto; }

.section-label { color: var(--gold); font-size: 9px; letter-spacing: 4px; text-transform: uppercase; margin-bottom: 22px; }

.section-title { font: 400 clamp(38px, 9vw, 58px) / 1.12 "Cormorant Garamond", serif; margin-bottom: 25px; }

.body-copy { font-size: 14px; line-height: 2.1; color: rgb(188, 183, 170); font-weight: 300; }

.divider { width: 45px; height: 1px; background: var(--gold); margin: 30px 0px; }

.letter { background: linear-gradient(145deg, rgb(21, 23, 15), rgb(14, 16, 12)); border: 1px solid var(--line); padding: 35px 25px; position: relative; }

.letter::before { content: "â€œ"; position: absolute; top: -18px; right: 22px; font: 100px "Cormorant Garamond", serif; color: rgba(216, 181, 109, 0.114); }

.letter p { color: rgb(199, 192, 178); font: 400 17px / 2 "Cormorant Garamond", serif; position: relative; }

.letter p + p { margin-top: 18px; }

.letter-sign { margin-top: 30px; font: italic 25px "Cormorant Garamond", serif; color: var(--gold); }

.gallery-head { text-align: center; }

.gallery-head .section-title { margin-bottom: 12px; }

.gallery-head .body-copy { font-size: 12px; }

.upload-label { display: inline-block; border: 1px solid var(--line); color: var(--gold); padding: 15px 18px; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin-top: 25px; cursor: pointer; }

#photoInput { display: none; }

.gallery { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 12px; margin-top: 28px; }

.photo-card { min-width: 0px; position: relative; border: 1px solid var(--line); background: var(--panel); overflow: hidden; }

.photo-card img { width: 100%; height: 220px; display: block; object-fit: cover; transition: transform 0.6s; }

.photo-card:active img { transform: scale(1.04); }

.photo-card figcaption { font: italic 17px "Cormorant Garamond", serif; color: var(--gold); padding: 12px; overflow-wrap: anywhere; cursor: pointer; }

.photo-card .remove { position: absolute; top: 8px; right: 8px; border: 0px; background: rgba(9, 11, 8, 0.867); color: white; padding: 8px 10px; }

.empty-gallery { grid-column: 1 / -1; padding: 40px 15px; text-align: center; border: 1px dashed var(--line); color: var(--muted); font: italic 19px / 1.9 "Cormorant Garamond", serif; }

.memory-list { display: grid; gap: 12px; margin-top: 32px; }

.memory { width: 100%; background: rgb(16, 18, 13); border: 1px solid rgba(255, 255, 255, 0.07); padding: 21px 18px; color: var(--cream); text-align: left; display: flex; gap: 15px; align-items: center; transition: 0.3s; }

.memory:hover, .memory:focus-visible { border-color: var(--gold); }

.memory-icon { font-size: 25px; flex-shrink: 0; }

.memory-text { flex: 1 1 0%; min-width: 0px; }

.memory-title { display: block; font: 400 21px "Cormorant Garamond", serif; }

.memory-sub { display: block; font-size: 10px; color: rgb(143, 138, 125); margin-top: 5px; line-height: 1.6; }

.memory-plus { color: var(--gold); font-size: 19px; }

.memory-answer { display: none; margin-top: 13px; color: rgb(200, 189, 168); font: italic 18px / 1.9 "Cormorant Garamond", serif; }

.memory.open .memory-answer { display: block; animation: 0.4s ease 0s 1 normal none running reveal; }

.memory.open .memory-plus { transform: rotate(45deg); }

@keyframes reveal { 
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.promise { text-align: center; padding: 70px 25px; background: radial-gradient(rgba(216, 181, 109, 0.047), transparent 72%); }

.promise .section-title { font-size: clamp(42px, 10vw, 66px); }

.promise .body-copy { max-width: 420px; margin: auto; }

.final-card { border: 1px solid var(--line); padding: 35px 23px; text-align: center; margin-top: 35px; }

.final-card .sun { font-size: 46px; margin-bottom: 18px; }

.final-card h3 { font: 400 32px "Cormorant Garamond", serif; margin-bottom: 15px; }

.final-card p { color: var(--muted); font-size: 12px; line-height: 2; }

.gold-btn { display: inline-block; margin-top: 25px; border: 1px solid var(--gold); background: var(--gold); color: rgb(9, 11, 8); padding: 15px 22px; font-size: 10px; letter-spacing: 2px; }

footer { border-top: 1px solid rgba(255, 255, 255, 0.063); text-align: center; padding: 35px 20px; color: rgb(119, 115, 104); font-size: 10px; line-height: 2.2; letter-spacing: 1px; }

footer strong { color: var(--gold); font-weight: 400; }

.reveal-on-scroll { opacity: 0; transform: translateY(22px); transition: opacity 0.8s, transform 0.8s; }

.reveal-on-scroll.visible { opacity: 1; transform: translateY(0px); }

.toast { position: fixed; z-index: 150; bottom: 22px; left: 50%; transform: translate(-50%, 20px); background: rgb(227, 197, 131); color: rgb(20, 20, 13); padding: 13px 18px; font-size: 12px; width: max-content; max-width: 90%; text-align: center; opacity: 0; pointer-events: none; transition: 0.3s; }

.toast.show { opacity: 1; transform: translate(-50%, 0px); }

#petals { position: fixed; inset: 0px; pointer-events: none; z-index: 80; overflow: hidden; }

.petal { position: absolute; top: -35px; animation: auto linear 0s 1 normal forwards running fall; opacity: 0.9; }

@keyframes fall { 
  100% { transform: translate3d(var(--drift),110vh,0) rotate(650deg); opacity: 0.05; }
}

@media (min-width: 650px) {
  .section { padding: 105px 30px; }
  .letter { padding: 48px; }
  .gallery { grid-template-columns: repeat(3, minmax(0px, 1fr)); }
  .photo-card img { height: 270px; }
  .hero { min-height: 90vh; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
}
